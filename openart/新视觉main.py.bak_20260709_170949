def draw_cell_codes(img, out_bytes):
    if USE_WINDOWING:
        rx, ry = 0, 0
        local_x_lines = [x - ROI_X1 for x in x_lines]
        local_y_lines = [y - ROI_Y1 for y in y_lines]
    else:
        rx, ry = ROI_X1, ROI_Y1
        local_x_lines = x_lines
        local_y_lines = y_lines

    img.draw_rectangle(rx, ry, ROI_W, ROI_H, color=(255, 255, 255), thickness=1)

    for x in local_x_lines[1:-1]:
        img.draw_line(x, ry, x, ry + ROI_H, color=(255, 255, 255), thickness=1)

    for y in local_y_lines[1:-1]:
        img.draw_line(rx, y, rx + ROI_W, y, color=(255, 255, 255), thickness=1)

    for gy in range(GRID_H):
        for gx in range(GRID_W):
            idx = gy * GRID_W + gx
            v = out_bytes[idx]
            if v > 5:
                continue

            cx, cy = points[idx]
            img.draw_string(cx - TEXT_DX, cy - TEXT_DY, str(v), color=(0, 0, 0), scale=2, thickness=2)

def draw_player_center(img):
    if not DEBUG_TRACK:
        return
    if not player_found:
        return

    # 车中心（红）
    if player_cx >= 0 and player_cy >= 0:
        gx = player_cx + ROI_X1
        gy = player_cy + ROI_Y1
        img.draw_cross(gx, gy, color=(255, 0, 0), size=4, thickness=1)
        img.draw_circle(gx, gy, 4, color=(255, 0, 0), thickness=1)

def draw_search_region(img):
    if not DEBUG_TRACK:
        return
    if debug_search_px0 < 0:
        return

    x = debug_search_px0 + ROI_X1
    y = debug_search_py0 + ROI_Y1
    w = debug_search_px1 - debug_search_px0
    h = debug_search_py1 - debug_search_py0

    if w > 0 and h > 0:
        img.draw_rectangle(x, y, w, h, color=(255, 255, 0), thickness=2)

def append_i16(buf, value):
    value = int(value) & 0xFFFF
    buf.append(value & 0xFF)
    buf.append((value >> 8) & 0xFF)

def append_i8(buf, value):
    buf.append(int(value) & 0xFF)

def append_cell_slots(buf, cells, max_count):
    count = len(cells)
    if count > max_count:
        count = max_count
    buf.append(count)
    for i in range(max_count):
        if i < count:
            append_i8(buf, cells[i][0])
            append_i8(buf, cells[i][1])
        else:
            append_i8(buf, -1)
            append_i8(buf, -1)

def send_full_map(out, car_x_mm, car_y_mm, car_theta_x10):
    payload = bytearray()
    payload.append(GRID_W)
    payload.append(GRID_H)

    walls = bytearray(24)
    for idx, v in enumerate(out):
        if v == ENC["WALL"]:
            walls[idx >> 3] |= 1 << (idx & 7)
    payload.extend(walls)

    append_cell_slots(payload, collect_cells(out, ENC["BOX"], MAX_BOXES), MAX_BOXES)
    append_cell_slots(payload, collect_cells(out, ENC["GOAL"], MAX_GOALS), MAX_GOALS)
    append_cell_slots(payload, collect_cells(out, ENC["BOMB"], MAX_BOMBS), MAX_BOMBS)

    append_i16(payload, car_x_mm)
    append_i16(payload, car_y_mm)
    append_i16(payload, car_theta_x10)
    payload.append(xor_checksum(payload))

    pkt = bytearray([VP_HEADER_0, VP_HEADER_1, VP_TYPE_FULL_MAP])
    pkt.extend(payload)
    uart.write(pkt)

def send_pos_update(frame_id, out, car_x_mm, car_y_mm, car_theta_x10):
    payload = bytearray()
    payload.append(frame_id & 0xFF)
    append_i16(payload, car_x_mm)
    append_i16(payload, car_y_mm)
    append_i16(payload, car_theta_x10)

    boxes = collect_cells(out, ENC["BOX"], MAX_BOXES)
    bombs = collect_cells(out, ENC["BOMB"], MAX_BOMBS)

    payload.append(len(boxes))
    for gx, gy in boxes:
        append_i8(payload, gx)
        append_i8(payload, gy)

    payload.append(len(bombs))
    for gx, gy in bombs:
        append_i8(payload, gx)
        append_i8(payload, gy)

    payload.append(xor_checksum(payload))

    pkt = bytearray([VP_HEADER_0, VP_HEADER_1, VP_TYPE_POS_UPDATE])
    pkt.extend(payload)
    uart.write(pkt)

# =========================
# 主循环
# =========================
frame_id = 0
last_pos_update_ms = 0
last_car_x_mm = 0
last_car_y_mm = 0
last_car_theta_x10 = 0
car_known = False

while True:
    poll_map_request()

    now_ms = time.ticks_ms()
    need_pos_update = time.ticks_diff(now_ms, last_pos_update_ms) >= POS_UPDATE_PERIOD_MS
    need_full_map = full_map_requested

    if not need_pos_update and not need_full_map:
        if IDLE_UART_SLEEP_US > 0:
            time.sleep_us(IDLE_UART_SLEEP_US)
        continue

    clock.tick()
    img = sensor.snapshot()

    # 每帧先清空调试区域
    debug_search_px0 = -1
    debug_search_py0 = -1
    debug_search_px1 = -1
    debug_search_py1 = -1

    out = build_current_map(img)

    player_found = False
    pos = None

    if last_player_gx >= 0 and last_player_gy >= 0:
        pos = find_player(
            img, last_player_gx, last_player_gy,
            PLAYER_SCAN_STEP_MODE2,
            PLAYER_MIN_HIT_MODE2,
        )

    if pos is None:
        pos = find_player_full_frame(
            img,
            PLAYER_SCAN_STEP_MODE2,
            PLAYER_MIN_HIT_MODE2,
        )

    if pos is None:
        for attempt in range(PLAYER_FIND_EXTRA_SNAPSHOTS):
            img = sensor.snapshot()
            pos = find_player_full_frame(
                img,
                PLAYER_SCAN_STEP_MODE2,
                PLAYER_MIN_HIT_MODE2,
            )
            if pos is not None:
                break

    if pos is not None:
        player_cx, player_cy = pos
        player_found = True
        last_car_x_mm, last_car_y_mm = local_player_to_mm(player_cx, player_cy)
        last_player_gx, last_player_gy = local_player_to_grid(player_cx, player_cy)
        car_known = True
        if DEBUG_TRACK:
            print("CENTER =", int(player_cx), int(player_cy), "grid", last_player_gx, last_player_gy)
    else:
        player_cx = -1
        player_cy = -1
        if DEBUG_TRACK:
            print("PLAYER not found")

    if need_pos_update:
        send_pos_update(frame_id, out, last_car_x_mm, last_car_y_mm, last_car_theta_x10)
        frame_id = (frame_id + 1) & 0xFF
        last_pos_update_ms = now_ms

    if need_full_map:
        send_full_map(out, last_car_x_mm, last_car_y_mm, last_car_theta_x10)
        full_map_requested = False

    # 可选显示
    if SHOW_CELL_CODES:
        draw_cell_codes(img, out)

    if DEBUG_TRACK:
        draw_search_region(img)
        draw_player_center(img)

    if SHOW_FPS:
        img.draw_string(2, 2, "FPS: %.1f" % clock.fps())
