last_map = bytearray([ENC["EMPTY"]] * (GRID_W * GRID_H))

def _grid_idx_at_full_pixel(ax_full, ay_full):
    """整图坐标落在哪一格；越界返回 -1。"""
    gx = -1
    for i in range(GRID_W):
        if x_lines[i] <= ax_full < x_lines[i + 1]:
            gx = i
            break
    if gx < 0:
        return -1
    for j in range(GRID_H):
        if y_lines[j] <= ay_full < y_lines[j + 1]:
            return j * GRID_W + gx
    return -1

def build_current_map(img):
    out = bytearray(GRID_W * GRID_H)
    for idx, (px, py) in enumerate(points):
        if SAMPLE_MODE == 1:
            L_val, A_val, B_val = sample1_lab(img, px, py)
        else:
            L_val, A_val, B_val = sample5_lab(img, px, py)
        code = classify_lab_code(L_val, A_val, B_val)
        if code == 255:
            out[idx] = last_map[idx] if USE_TEMPORAL_FALLBACK else ENC["EMPTY"]
        else:
            out[idx] = code
    last_map[:] = out
    return out

def collect_cells(out, code, max_count):
    cells = []
    for idx, v in enumerate(out):
        if v == code:
            cells.append((idx % GRID_W, idx // GRID_W))
            if len(cells) >= max_count:
                break
    return cells

def local_player_to_mm(cx, cy):
    if cx < 0 or cy < 0:
        return 0, 0
    x_mm = int(cx * GRID_W * GRID_SIZE_MM / ROI_W + 0.5)
    y_mm = int(cy * GRID_H * GRID_SIZE_MM / ROI_H + 0.5)
    return x_mm, y_mm

def local_player_to_grid(cx, cy):
    if cx < 0 or cy < 0:
        return -1, -1
    ax = cx + ROI_X1
    ay = cy + ROI_Y1
    idx = _grid_idx_at_full_pixel(ax, ay)
    if idx < 0:
        return -1, -1
    return idx % GRID_W, idx // GRID_W

def find_player_full_frame(img, scan_step=None, min_hit=None):
    global debug_search_px0, debug_search_py0, debug_search_px1, debug_search_py1

    if scan_step is None:
        scan_step = PLAYER_SCAN_STEP_MODE2
    if min_hit is None:
        min_hit = PLAYER_MIN_HIT_MODE2

    if USE_WINDOWING:
        px0, py0 = 0, 0
        px1, py1 = img.width(), img.height()
        ox, oy = 0, 0
    else:
        px0, py0 = 0, 0
        px1, py1 = ROI_W, ROI_H
        ox, oy = ROI_X1, ROI_Y1

    debug_search_px0 = px0
    debug_search_py0 = py0
    debug_search_px1 = px1
    debug_search_py1 = py1

    cnt = 0
    sum_x = 0
    sum_y = 0
    player_code = ENC["PLAYER"]

    for y in range(py0, py1, scan_step):
        for x in range(px0, px1, scan_step):
            ax = x + ox
            ay = y + oy
            L_val, A_val, B_val = sample1_lab(img, ax, ay)
            if classify_lab_code_with_player_segs(L_val, A_val, B_val, _B_PLAYER_TRACK_SEGS) != player_code:
                continue
            sum_x += x
            sum_y += y
            cnt += 1

    if cnt < min_hit:
        return None
    return (sum_x // cnt, sum_y // cnt)

