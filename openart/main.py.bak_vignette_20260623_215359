# 8. 全图网格生成（来自 识别代码.py，不变）
# ============================================================

def make_full_map_grid(img, boxes, bombs, car):
    grid = []
    for row in range(ROWS):
        line = []
        for col in range(COLS):
            r, g, b = avg_rgb_at_cell(img, col, row)
            line.append(classify_cell_rgb(r, g, b))
        grid.append(line)

    for comp in bombs:
        x = clamp_cell_x(comp[0])
        y = clamp_cell_y(comp[1])
        grid[y][x] = "!"

    for comp in boxes:
        x = clamp_cell_x(comp[0])
        y = clamp_cell_y(comp[1])
        grid[y][x] = "$"

    if car is not None:
        x = clamp_cell_x(car[0])
        y = clamp_cell_y(car[1])
        grid[y][x] = "@"

    goals = detect_goals_from_grid(grid)
    return grid, goals


