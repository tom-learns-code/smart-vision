def lerp(a, b, t):
    return a + (b - a) * t


def screen_point_from_uv(u, v):
    top_x = lerp(LT[0], RT[0], u)
    top_y = lerp(LT[1], RT[1], u)
    bottom_x = lerp(LB[0], RB[0], u)
    bottom_y = lerp(LB[1], RB[1], u)
    x = lerp(top_x, bottom_x, v)
    y = lerp(top_y, bottom_y, v)
    return int(x), int(y)


def screen_point_from_map(mx, my):
    return screen_point_from_uv(mx / COLS, my / ROWS)


def clamp_cell_x(x):
    if x < 0:        return 0
    if x >= COLS:    return COLS - 1
    return int(x)


def clamp_cell_y(y):
    if y < 0:        return 0
    if y >= ROWS:    return ROWS - 1
    return int(y)


def grid_to_mm(g):
    return int(g * GRID_SIZE_MM + 0.5)


def deg_to_x10(deg):
    return int(deg * 10 + 0.5)


def grid_to_x10(g):
    return int(g * 10 + 0.5)


